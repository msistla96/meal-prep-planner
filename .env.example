# Server
PORT=4000
SESSION_SECRET=dev-only-secret-change-me

# Agent LLM provider — "mock" (default, no API key needed) or "openai-compatible"
LLM_PROVIDER=mock
# Required when LLM_PROVIDER=openai-compatible
LLM_API_KEY=
# Optional overrides for LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Agent background expiry scan
AGENT_SCAN_INTERVAL_MS=300000
AGENT_EXPIRY_WINDOW_DAYS=2
